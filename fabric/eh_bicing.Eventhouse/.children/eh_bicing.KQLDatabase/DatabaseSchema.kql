.create-merge table dim_weather (hour_local:datetime, temperature_c:real, precipitation_mm:real, wind_ms:real, n_readings:int) 
.create-or-alter table dim_weather ingestion parquet mapping 'dim_weather_mapping'
```
[{"Properties":{"Path":"$['hour_local']"},"column":"hour_local","datatype":""},{"Properties":{"Path":"$['temperature_c']"},"column":"temperature_c","datatype":""},{"Properties":{"Path":"$['precipitation_mm']"},"column":"precipitation_mm","datatype":""},{"Properties":{"Path":"$['wind_ms']"},"column":"wind_ms","datatype":""},{"Properties":{"Path":"$['n_readings']"},"column":"n_readings","datatype":""}]
```
.create-or-alter function with (folder = "bicing", docstring = "Average bikes and docks per local hour", skipvalidation = "true") hourly_occupancy() {
    station_status
    | extend hour_local = bin(datetime_utc_to_local(snapshot_at, "Europe/Madrid"), 1h)
    | summarize avg_bikes = avg(bikes_available), avg_docks = avg(docks_available), readings = count() by hour_local
}
.create-or-alter materialized-view  hourly_station_mv on table station_status { station_status
    | summarize avg_bikes = avg(bikes_available), readings = count() by station_id, hour_utc = bin(snapshot_at, 1h) }
