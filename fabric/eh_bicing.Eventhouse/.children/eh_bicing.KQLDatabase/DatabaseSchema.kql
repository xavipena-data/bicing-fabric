.create-merge table dim_station (station_id:int, name:string, station_kind:string, physical_configuration:string, address:string, lat:real, lon:real, altitude:real, district_code:string, district:string, neighbourhood_code:string, neighbourhood:string, post_code:string, is_charging_station:bool, first_seen_at:datetime, last_seen_at:datetime) 
.create-or-alter table dim_station ingestion parquet mapping 'dim_station_mapping'
```
