.create-merge table station_status (snapshot_at:datetime, station_id:int, bikes_available:int, mechanical_bikes:int, ebikes:int, docks_available:int, last_reported_at:datetime, status:string) 
.create-or-alter table station_status ingestion parquet mapping 'station_status_mapping'
```
[{"Properties":{"Path":"$['snapshot_at']"},"column":"snapshot_at","datatype":""},{"Properties":{"Path":"$['station_id']"},"column":"station_id","datatype":""},{"Properties":{"Path":"$['bikes_available']"},"column":"bikes_available","datatype":""},{"Properties":{"Path":"$['mechanical_bikes']"},"column":"mechanical_bikes","datatype":""},{"Properties":{"Path":"$['ebikes']"},"column":"ebikes","datatype":""},{"Properties":{"Path":"$['docks_available']"},"column":"docks_available","datatype":""},{"Properties":{"Path":"$['last_reported_at']"},"column":"last_reported_at","datatype":""},{"Properties":{"Path":"$['status']"},"column":"status","datatype":""}]
